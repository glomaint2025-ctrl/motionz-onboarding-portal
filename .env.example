# Motionz Onboarding Portal - Environment Configuration

# 1. Local Database (Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/motionz_portal

# 2. Supabase Configuration (When connecting to Supabase cloud)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Application Security & Session Secret
SESSION_SECRET=motionz-super-secure-session-secret-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# 4. Third-Party Integration Placeholders (Configured per client in Admin)
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 5. Transactional Email - invites, sign-in links, password resets, media buyer alerts
#    Set RESEND_API_KEY (preferred) or BREVO_API_KEY. Without either, emails are printed
#    to the server console (development only). Until a domain is verified in Resend, use
#    onboarding@resend.dev as the sender; Resend then only delivers to the account owner's email.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Motionz Portal
MEDIA_BUYER_EMAIL=

# 6. GoHighLevel webhook shared secret. Each GHL workflow "Webhook" action must send it
#    in the `x-motionz-webhook-secret` header. Required in production.
GHL_WEBHOOK_SECRET=
