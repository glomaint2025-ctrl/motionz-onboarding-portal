# Motionz Onboarding Portal - Environment Configuration
# Copy to .env.local and fill in. Placeholders only: never commit real values.

# 1. Supabase (database, auth and file storage). Without these the app runs on an
#    in-memory demo store (development and tests only; refused in production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Application security and public address
#    SESSION_SECRET: at least 32 random characters. Required in production.
SESSION_SECRET=replace-with-at-least-32-random-characters
#    The address people open the portal at. Used for links in emails and for redirects.
#    NEXTAUTH_URL is read first; APP_URL and NEXT_PUBLIC_APP_URL are accepted as alternatives.
NEXTAUTH_URL=http://localhost:3000
# APP_URL=
# NEXT_PUBLIC_APP_URL=

# 3. Staff access
#    Extra admin emails besides admin@motionz.ai (comma-separated).
ADMIN_EMAILS=
#    STAGING ONLY - never set in production. Exact non-@motionz.ai addresses allowed to sign in as
#    staff (comma-separated), so test staff email can reach a developer's inbox.
# STAFF_EXTRA_EMAILS=

# 4. Transactional Email - invites, sign-in links, password resets, media buyer alerts
#    Set RESEND_API_KEY (preferred) or BREVO_API_KEY. Without either, emails are printed
#    to the server console (development only). Until a domain is verified in Resend, use
#    onboarding@resend.dev as the sender; Resend then only delivers to the account owner's email.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Motionz Portal
#    Always emailed when an onboarding form arrives, in addition to the list in Admin > Settings.
MEDIA_BUYER_EMAIL=

# 5. GoHighLevel webhook shared secret (see docs/07-integrations/ghl-workflows.md).
#    Each GHL workflow "Webhook" action sends it as the Custom Data entry `secret`
#    (customData.secret), because GHL's standard Webhook action cannot set headers.
#    The `x-motionz-webhook-secret` header is accepted as well. Required in production.
GHL_WEBHOOK_SECRET=

# 6. Google files (one Drive folder, tracking sheet and calculator per client), created by the
#    Apps Script in scripts/google-apps-script. Both values are needed; without them no files are made.
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_SCRIPT_SECRET=

# 7. Roof measurement tool (Google Solar API). Without it the tool reports that it is not set up.
GOOGLE_SOLAR_API_KEY=

# Local testing only: send every email to this one inbox (ignored in production)
# EMAIL_TEST_REDIRECT_TO=you@example.com
